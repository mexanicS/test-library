<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Домашняя библиотека</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/vendor/quill/quill.snow.css" />
    <link rel="stylesheet" href="~/css/site-simple.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container d-flex align-items-center justify-content-between gap-3 py-3">
            <a class="brand" asp-controller="Books" asp-action="Index">Домашняя библиотека</a>
            <nav class="d-flex gap-3">
                <a asp-controller="Books" asp-action="Index">Книги</a>
                <a asp-controller="Books" asp-action="Chapters">Поиск по оглавлению</a>
            </nav>
        </div>
    </header>

    <main class="container py-4 py-md-5">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success" role="status">@message</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container py-4">
            <span>Домашняя библиотека</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
