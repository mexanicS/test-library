@model IReadOnlyList<BookListItem>
@{
    ViewData["Title"] = "Книги";
}

<div class="page-heading">
    <div>
        <h1>Книги</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create">Добавить книгу</a>
</div>

<form method="get" asp-action="Index" class="search-bar mb-4">
    <label for="search" class="visually-hidden">Поиск по названию или автору</label>
    <input id="search" name="search" class="form-control" value="@ViewData["Search"]" placeholder="Название или автор" maxlength="200" />
    <button type="submit" class="btn btn-outline-primary">Найти</button>
    @if (!string.IsNullOrWhiteSpace(ViewData["Search"] as string))
    {
        <a class="btn btn-link" asp-action="Index">Сбросить</a>
    }
</form>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2>Книг пока нет</h2>
        <p>Добавьте первую книгу или измените поисковый запрос.</p>
        <a asp-action="Create" class="btn btn-primary">Добавить книгу</a>
    </div>
}
else
{
    <div class="book-list">
        @foreach (var book in Model)
        {
            <article class="book-row">
                <div class="book-row-main">
                    <h2><a asp-action="Details" asp-route-id="@book.Id">@book.Title</a></h2>
                    <p class="book-author">@book.Author</p>
                </div>
                <div class="book-meta">
                    <span>@(book.PublishedYear?.ToString() ?? "Год не указан")</span>
                    <span>@RussianText.ChapterCount(book.ChapterCount)</span>
                    @if (!string.IsNullOrWhiteSpace(book.Isbn))
                    {
                        <span>ISBN @book.Isbn</span>
                    }
                </div>
            </article>
        }
    </div>
}
